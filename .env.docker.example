# ---------------------------------------------------------------------------
# Copy to .env, then fill in. Everything has a working default EXCEPT the
# secrets that must be stable across restarts (encryption + JWT keys) and the
# provider keys for live features. With just POSTGRES_PASSWORD set, the stack
# runs end-to-end in mock/simulate mode on Postgres.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_PASSWORD=change-me-in-prod
# JOBSEARCH_DATABASE_URL is set by docker-compose to the `db` service — no need
# to set it here.

# --- Production / VPS deploy (see deploy/DEPLOY.md) -------------------------
# Public API hostname — put a DNS A record for it on the VPS IP. Caddy gets a
# TLS cert for this automatically. Only needed for the docker-compose.prod.yml
# (Caddy) overlay.
API_DOMAIN=
# Frontend origin(s) allowed to call the API (comma-separated). Set to your
# Readdy/Vercel URL in production, or CORS will block the browser.
JOBSEARCH_CORS_ORIGINS=http://localhost:3000

# --- Firebase Auth (sign-in without handling passwords; OPTIONAL) ----------
# The frontend signs in with Firebase and posts the ID token to /auth/firebase.
# "mock" (default) accepts a dev token (a plain email) so it works offline.
# "live" verifies real tokens — needs `pip install firebase-admin`, the project
# id, and a service-account JSON on the server. See docs/firebase-auth/.
JOBSEARCH_FIREBASE_AUTH=mock            # mock | live
JOBSEARCH_FIREBASE_PROJECT_ID=
# Service account — a file path (VPS) OR the raw JSON as one value (Railway/Cloud
# Run). Set exactly one.
JOBSEARCH_FIREBASE_CREDENTIALS_FILE=
JOBSEARCH_FIREBASE_CREDENTIALS_JSON=

# --- Security (REQUIRED for production; otherwise regenerated each restart) --
# Generate:  docker compose run --rm api python -m jobsearch.security.crypto keygen
JOBSEARCH_ENCRYPTION_KEY=

# JWT RS256 signing keys (PEM). Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_priv.pem
#   openssl rsa -in jwt_priv.pem -pubout -out jwt_pub.pem
# Then paste as single-line PEMs with literal \n, or mount as files and point at them.
JOBSEARCH_JWT_PRIVATE_KEY=
JOBSEARCH_JWT_PUBLIC_KEY=

# --- LLM / embeddings (leave as mock to run without keys) ------------------
JOBSEARCH_LLM_PROVIDER=mock            # anthropic | openai | mock
JOBSEARCH_EMBEDDING_PROVIDER=mock      # openai | mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OAuth integrations ----------------------------------------------------
JOBSEARCH_OAUTH_MODE=mock              # live requires the client creds below
JOBSEARCH_OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/integrations/callback
JOBSEARCH_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=
GREENHOUSE_CLIENT_ID=
GREENHOUSE_CLIENT_SECRET=

# --- Automation ------------------------------------------------------------
JOBSEARCH_AUTOMATION_MODE=simulate     # live enables real Gmail/browser submission

# --- Reminders (OPTIONAL — review-checkpoint nudges) -----------------------
# Out-of-band reminders so the "review & renew" checkpoint reaches users when the
# app is closed. All default to mock (recorded, not sent). In-app + email work
# with the email sender above; SMS + web push need the settings below.
JOBSEARCH_SMS_PROVIDER=mock            # http = POST {to,from,body} to your SMS API
JOBSEARCH_SMS_PROVIDER_URL=
JOBSEARCH_SMS_FROM=
JOBSEARCH_SMS_API_KEY=
# Web Push (VAPID) — generate a keypair (e.g. `web-push generate-vapid-keys`),
# and `pip install pywebpush` in the api image.
JOBSEARCH_PUSH_PROVIDER=mock           # webpush = send via the browser Push service
JOBSEARCH_VAPID_PUBLIC_KEY=
JOBSEARCH_VAPID_PRIVATE_KEY=
JOBSEARCH_VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- TURN relay for peer video calls (OPTIONAL) ----------------------------
# Only needed for peer practice interviews behind restrictive / symmetric NATs.
# Leave all blank and peer calls use public STUN (works on most networks).
# To run the bundled coturn relay: set TURN_SECRET + JOBSEARCH_TURN_URLS below,
# then `docker compose --profile turn up --build`.
#   TURN_SECRET=$(openssl rand -hex 32)   # shared by the API and coturn
TURN_SECRET=
TURN_REALM=hirewave.local
# The relay URL(s) the browser is told to use (comma-separated). Use your host's
# reachable address; add a turns:5349 entry once you've configured TLS in
# deploy/coturn/turnserver.conf.
JOBSEARCH_TURN_URLS=
# Credential lifetime in seconds (default 3600). Optional.
# JOBSEARCH_TURN_TTL_SECONDS=3600
