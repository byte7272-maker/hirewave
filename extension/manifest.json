{
  "manifest_version": 3,
  "name": "Project Harbor Connect",
  "version": "1.4.1",
  "description": "Connect a job board, pull jobs you view, and fill applications with your saved details — you submit, never your password.",
  "homepage_url": "https://hlrtlg.readdy.co",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "tabs", "storage", "scripting"],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*",
    "https://*.greenhouse.io/*",
    "https://*.workday.com/*",
    "https://*.myworkday.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.dice.com/*",
    "https://hirewave-production-3db3.up.railway.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Project Harbor Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://hlrtlg.readdy.co/*",
        "https://hirewave-production-3db3.up.railway.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.workday.com/*",
        "https://*.myworkday.com/*",
        "https://*.indeed.com/*",
        "https://*.ziprecruiter.com/*",
        "https://*.dice.com/*",
        "https://*.glassdoor.com/*"
      ],
      "js": ["apply.js"],
      "run_at": "document_idle"
    }
  ]
}
