# --- Automation worker (scheduler loop + Playwright/Chromium for live apply) --
# Build this as a SEPARATE Railway service from the same repo (point the worker
# service's config at railway.worker.json). It shares the web service's Postgres
# and JOBSEARCH_ENCRYPTION_KEY, and is the only process that submits for real.
# The web service keeps using the lean ./Dockerfile (no browser).
#
# Uses Microsoft's prebuilt Playwright image: Chromium + all OS deps are already
# baked in, so there's no fragile `playwright install --with-deps` layer to fail
# at build time. The pip Playwright version is PINNED to the image tag below so
# the package and the bundled browser always match — bump BOTH together.
#
#   image tag  : v1.47.0-jammy
#   pip pin    : playwright==1.47.0
FROM mcr.microsoft.com/playwright/python:v1.47.0-jammy

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

# Install the package with the automation extra. Pin Playwright to the image's
# version so pip keeps the preinstalled browser-matched build (no re-download).
RUN pip install "playwright==1.47.0" ".[api,postgres,anthropic,openai,firebase,documents,automation]"

# The base image ships a non-root `pwuser` (uid 1000) that already owns the
# browser cache — run as it.
USER pwuser

# Background worker: no HTTP port. `exec` (via the python process as PID 1) lets
# SIGTERM trigger the worker's clean shutdown.
CMD ["python", "-m", "jobsearch.worker"]

# --- Alternative (no prebuilt base) -------------------------------------------
# If you'd rather not pull the ~1.5GB MS image, use a slim base and install the
# browser yourself (heavier, more failure-prone build):
#   FROM python:3.12-slim
#   ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
#   RUN pip install ".[api,postgres,anthropic,openai,firebase,documents,automation]" \
#       && playwright install --with-deps chromium
