# ---------------------------------------------------------------------------
# Job-Search Automation Platform — engine configuration
# Copy to .env and fill in. Everything has a safe offline default, so the
# engines run (in mock mode) with an empty .env.
# ---------------------------------------------------------------------------

# --- LLM / embeddings ------------------------------------------------------
# Provider for text generation: "anthropic", "openai", or "mock" (offline).
JOBSEARCH_LLM_PROVIDER=mock
# Provider for embeddings (job matching): "openai" or "mock" (deterministic
# offline). Anthropic has no embeddings API, so semantic matching uses OpenAI.
# Real embeddings are auto-wrapped in an LRU cache to avoid re-embedding.
JOBSEARCH_EMBEDDING_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Security --------------------------------------------------------------
# 32-byte key, base64 or hex encoded, used for AES-256-GCM field encryption
# (OAuth tokens at rest). Generate with:  python -m jobsearch.security.crypto keygen
JOBSEARCH_ENCRYPTION_KEY=

# JWT signing (RS256) for the API. Leave blank in dev to auto-generate an
# ephemeral keypair (tokens won't survive a restart). In production provide a
# real RSA keypair (PEM). Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_priv.pem
#   openssl rsa -in jwt_priv.pem -pubout -out jwt_pub.pem
JOBSEARCH_JWT_PRIVATE_KEY=
JOBSEARCH_JWT_PUBLIC_KEY=

# --- OAuth provider credentials (only needed for live integration flows) ---
# "mock" (default) = offline flow with a fake token exchanger (dev/tests).
# "live" = real RFC 6749 token exchange; requires the client id/secret below.
JOBSEARCH_OAUTH_MODE=mock
JOBSEARCH_OAUTH_REDIRECT_BASE=http://localhost:8000/api/v1/integrations/callback
# Set to redirect the browser back to the frontend after connect (real flow):
#   http://localhost:3000/integrations
JOBSEARCH_OAUTH_SUCCESS_REDIRECT=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=
GREENHOUSE_CLIENT_ID=
GREENHOUSE_CLIENT_SECRET=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=

# --- Persistence -----------------------------------------------------------
# Blank = in-memory repositories (default; used by tests and the offline demo).
# Set a SQLAlchemy URL to persist across restarts:
#   sqlite:///./data/jobsearch.db
#   postgresql+psycopg://user:pass@localhost:5432/jobsearch   (needs the `postgres` extra)
JOBSEARCH_DATABASE_URL=

# --- Automation ------------------------------------------------------------
# "simulate" returns fake submissions (no browser); "live" would drive a real
# headless browser / platform API (requires the `automation` extra + adapters).
JOBSEARCH_AUTOMATION_MODE=simulate

# --- Exposure monitoring ---------------------------------------------------
# "mock" = offline fake breach data; "hibp" = live Have I Been Pwned (needs key).
# We use licensed breach-intel APIs — we never crawl the dark web.
JOBSEARCH_EXPOSURE_PROVIDER=mock
HIBP_API_KEY=

# --- Reminders (OPTIONAL — review-checkpoint nudges) -----------------------
# Out-of-band nudges for the "review & renew" checkpoint. Default mock (recorded).
JOBSEARCH_SMS_PROVIDER=mock            # http = POST {to,from,body} to your SMS API
JOBSEARCH_SMS_PROVIDER_URL=
JOBSEARCH_SMS_FROM=
JOBSEARCH_SMS_API_KEY=
JOBSEARCH_PUSH_PROVIDER=mock           # webpush = VAPID browser push (pip install pywebpush)
JOBSEARCH_VAPID_PUBLIC_KEY=
JOBSEARCH_VAPID_PRIVATE_KEY=
JOBSEARCH_VAPID_SUBJECT=mailto:admin@yourdomain.com

# --- TURN relay for peer video calls (OPTIONAL) ----------------------------
# Only needed for peer practice interviews behind restrictive / symmetric NATs.
# Leave blank and peer calls use public STUN. To use a relay, set the URL(s)
# (comma-separated) and a secret; the API mints short-lived per-user creds from
# the secret (it never reaches the browser). coturn must use the SAME secret.
JOBSEARCH_TURN_URLS=
JOBSEARCH_TURN_SECRET=
# JOBSEARCH_TURN_TTL_SECONDS=3600
# Static-credential fallback instead of a secret (secret wins if both set):
# JOBSEARCH_TURN_USERNAME=
# JOBSEARCH_TURN_PASSWORD=
